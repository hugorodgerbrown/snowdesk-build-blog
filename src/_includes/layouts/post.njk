---
layout: layouts/base.njk
---
{%- set postUrl = page.url | siteUrl %}
{#- written_by: claude in a post's front matter marks a post Claude wrote: the
    page says so in a callout, and the JSON-LD names Claude as author with the
    site author as editor, so readers and machines are told the same thing.
    schema.org's author takes a Person or an Organization; Claude is neither,
    and Organization is the less wrong of the two. #}
{%- if written_by == "claude" %}
  {%- set ldAuthor = { "@type": "Organization", "name": "Claude", "url": "https://claude.ai/" } %}
  {%- set ldEditor = { "@type": "Person", "name": site.author.name } %}
{%- else %}
  {%- set ldAuthor = { "@type": "Person", "name": site.author.name } %}
{%- endif %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": page.date | isoDate,
  "dateModified": (updated or page.date) | isoDate,
  "url": postUrl,
  "mainEntityOfPage": postUrl,
  "inLanguage": site.language,
  "author": ldAuthor,
  "editor": ldEditor,
  "publisher": { "@id": site.app.url + "#organization" },
  "isPartOf": { "@id": site.url + "#website" },
  "about": { "@type": "SoftwareApplication", "name": site.app.name, "url": site.app.url, "applicationCategory": "TravelApplication" }
} | jsonLd | safe }}</script>
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      {%- if updated %} · updated <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time>{% endif %}
    </p>
    {%- if written_by == "claude" %}
    <p class="post-callout" role="note"><span aria-hidden="true">✦</span> This post was written by Claude.</p>
    {%- endif %}
    {%- if description %}
    <p class="post-lede">{{ description }}</p>
    {%- endif %}
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
  <footer class="post-footer">
    <p><a href="/">← All posts</a> · <a href="{{ site.app.url }}">Try {{ site.app.name }}</a></p>
  </footer>
</article>
